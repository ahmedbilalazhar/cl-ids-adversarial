# --- Results: raw per-seed outputs are already versioned for this project.
# New runs should still be captured via `git add results/` explicitly.
# Uncomment to stop versioning regenerable per-seed files in the future:
# /results/runs/*_R_seed*.csv
# /results/runs/*_summary_seed*.json
/results/run_groups.log
# Phase 3 reference checkpoints/admission arrays contain derived flow data.
# Keep small JSON evidence/source snapshots; rebuild binary payloads locally.
/results/phase3-reference74-v1/**/*.npz
# Versioned CPU studies retain binary state locally; small JSON review evidence
# and deterministic source-only bundles remain available for explicit tracking.
/results/phase3-cpu-v2/**/*.npz
/results/phase3-cpu-v3/**/*.npz
/results/phase3-acquisition-diagnostic-v1/**/*.npz
/results/phase3-cpu-v3/profiling/*/local-worker-output.zip
/results/**/.*.lock
# Retain small Phase 3 execution/acceptance logs, including failed attempts.
!/results/phase3-*/**/*.log
!/results/phase3-*/*.log
