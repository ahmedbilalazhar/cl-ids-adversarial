digraph Phase2 {
graph [rankdir=LR, bgcolor="white", nodesep=.35, ranksep=.36, pad=.08, splines=polyline];
node [shape=plain, fontname="Arial", fontsize=18];
edge [color="#54616D", arrowsize=.8, penwidth=1.4];
data [label=<<TABLE BORDER="1" COLOR="#54616D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E8EFF5" ALIGN="LEFT"><FONT POINT-SIZE="22"><B>Data and<BR ALIGN="LEFT"/>representation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">CICIDS2017 + sidecar</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Audit; isolate sessions</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Frozen T0 transform</FONT></TD></TR></TABLE>>];
protocol [label=<<TABLE BORDER="1" COLOR="#54616D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#F8EEDB" ALIGN="LEFT"><FONT POINT-SIZE="22"><B>Protocol<BR ALIGN="LEFT"/>development</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Development gates</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Tune on clean banks</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Lock settings + analysis</FONT></TD></TR></TABLE>>];
framework [label=<<TABLE BORDER="1" COLOR="#54616D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E9EFE9" ALIGN="LEFT"><FONT POINT-SIZE="22"><B>Federated<BR ALIGN="LEFT"/>experiments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18"><B>Alternative run arms</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">FT / EI / DR</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">DR + DG / DM / DC</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">E1 acquire; E2 poison</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Withdraw; no fresh Hulk</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Local updates + FedAvg</FONT></TD></TR></TABLE>>];
evaluation [label=<<TABLE BORDER="1" COLOR="#54616D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E8EFF5" ALIGN="LEFT"><FONT POINT-SIZE="22"><B>Fixed-bank<BR ALIGN="LEFT"/>evaluation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Source-specific damage</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Persistence; acquisition</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Collateral errors; costs</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Predictions + metrics</FONT></TD></TR></TABLE>>];
analysis [label=<<TABLE BORDER="1" COLOR="#54616D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#EFEAF3" ALIGN="LEFT"><FONT POINT-SIZE="22"><B>Research<BR ALIGN="LEFT"/>analysis</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Paired comparisons</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Component experiments</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Failure investigation</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18"><B>Evidence + limitations</B></FONT></TD></TR></TABLE>>];
external [label=<<TABLE BORDER="1" COLOR="#54616D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT POINT-SIZE="22"><B>Separate exploratory check</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">CICIoT2023: own audit, scaler and schedule</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="18">Independent runs and descriptive conclusions</FONT></TD></TR></TABLE>>];
data -> protocol;
protocol -> framework;
framework -> evaluation;
evaluation -> analysis;
protocol -> external [style=dashed, constraint=false];
{rank=same; framework; external}
framework -> external [style=invis];
}
